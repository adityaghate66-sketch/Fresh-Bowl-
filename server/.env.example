# =====================================================================
# OOTA BACKEND — ENVIRONMENT VARIABLES (template)
# =====================================================================
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored (NEVER committed). .env.example is safe to push.

# Secret used to sign login tokens. Make your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (Render sets this automatically)
PORT=4000

# Allowed frontend origins (comma-separated). Add your Netlify/Vercel URL.
CLIENT_ORIGINS=http://localhost:5173,https://oota.netlify.app

# ---- MongoDB Atlas (the real cloud database) ----
# Paste your connection string from Atlas → Connect → Drivers.
# Example shape:
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Leave EMPTY (or delete the line) to run in local demo mode.
MONGODB_URI=

# Optional: database name inside the cluster (default: freshbowl)
MONGODB_DB=freshbowl
